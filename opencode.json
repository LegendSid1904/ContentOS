{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "enabled": true,
      "env": {
        "STITCH_API_KEY": "$STITCH_API_KEY",
        "GOOGLE_CLOUD_PROJECT": "$GOOGLE_CLOUD_PROJECT"
      }
    }
  }
}
