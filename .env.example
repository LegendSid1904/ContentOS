# ContentOS AI — Environment Variables
# Copy this to .env and fill in your values

# Database (for Drizzle migrations)
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres

# AI Provider (Groq - free LLM API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Search (Trend Surfing / Competitor Intel)
TAVILY_API_KEY=
BRAVE_API_KEY=

# App URL (for OAuth callbacks — set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Email)
RESEND_API_KEY=

# Canva Connect API
# Free to use — register at https://www.canva.com/developers/integrations/connect-api
# OAuth callback: {NEXT_PUBLIC_APP_URL}/api/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Canva brand template ID (optional — for autotemplate fill)
CANVA_BRAND_TEMPLATE_ID=

# Sentry
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Storage (using Supabase Storage)
SUPABASE_STORAGE_BUCKET=contentos-exports

# Stitch MCP
STITCH_API_KEY=
GOOGLE_CLOUD_PROJECT=
